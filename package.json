{
  "name": "issue-killer",
  "private": true,
  "version": "0.1.0",
  "author": "Tomáš Martykán",
  "repository": "github:martykan/issue-killer",
  "type": "module",
  "scripts": {
    "sync": "bun src/cli.ts sync",
    "status": "bun src/cli.ts status",
    "analyze": "bun src/cli.ts analyze",
    "investigate": "bun src/cli.ts investigate",
    "ui": "bun --hot src/server.ts",
    "typecheck": "tsc --noEmit",
    "desktop": "npx -y electrobun@2.0.4 dev",
    "desktop:build": "npx -y electrobun@2.0.4 build --env=stable",
    "typecheck:desktop": "npx -y electrobun@2.0.4 prepare >/dev/null && tsc --noEmit -p src/desktop",
    "desktop:install": "npx -y electrobun@2.0.4 build --env=stable && bun scripts/install-desktop.ts",
    "doctor": "bun src/cli.ts doctor",
    "settings": "bun src/cli.ts settings"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
